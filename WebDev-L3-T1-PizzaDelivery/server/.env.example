NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend.vercel.app

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=Pizza Delivery <your_email@example.com>

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

CRON_SECRET=replace_with_a_long_random_cron_secret

# Optional for cross-instance Socket.IO scaling.
# The current app works without it for low-traffic/single-instance use.
# REDIS_URL=rediss://...
